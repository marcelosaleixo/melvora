# Copie os valores para as variáveis do serviço no EasyPanel.
# Não coloque senhas reais neste arquivo nem faça commit de um .env com segredos.

SERVER_PORT=8086
DB_URL=jdbc:postgresql://app_postgres:5432/melvora
DB_USERNAME=postgres
DB_PASSWORD=SUBSTITUA_PELA_SENHA_DO_POSTGRES
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2
THYMELEAF_CACHE=true
COOKIE_SECURE=true
JPA_SHOW_SQL=false

MELVORA_BOOTSTRAP_ENABLED=true
MELVORA_BOOTSTRAP_MASTER_EMAIL=master@seudominio.com
MELVORA_BOOTSTRAP_MASTER_PASSWORD=DEFINA_UMA_SENHA_FORTE
MELVORA_BOOTSTRAP_MASTER_NAME=Administrador Master
MELVORA_BOOTSTRAP_COMPANY_NAME=Empresa Inicial
MELVORA_BOOTSTRAP_ADMIN_EMAIL=admin@seudominio.com
MELVORA_BOOTSTRAP_ADMIN_PASSWORD=DEFINA_OUTRA_SENHA_FORTE
MELVORA_BOOTSTRAP_ADMIN_NAME=Administrador

# Gere uma chave AES-256 Base64 de 32 bytes para esta variável.
MELVORA_SECRET_KEY=SUBSTITUA_POR_CHAVE_BASE64
MELVORA_WHATSAPP_WEBHOOK_VERIFY_TOKEN=DEFINA_TOKEN_WEBHOOK
MELVORA_PUBLIC_BASE_URL=https://SEU-DOMINIO
